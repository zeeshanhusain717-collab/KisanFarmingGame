<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvCastleCredits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#33691E"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvCastleTier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1B5E20"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Placeholder: baad mein tier ki asli image yahan lagegi -->
            <View
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="16dp"
                android:background="#A5D6A7" />

            <TextView
                android:id="@+id/tvCastleChapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="#424242"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvCastleBonus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#2E7D32"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCastleUpgrade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
